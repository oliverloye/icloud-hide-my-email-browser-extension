#!/bin/sh
# Default-branch guard. Stands in for GitHub branch protection, which private
# repositories on the free plan cannot use. Blocks deleting or force-pushing
# the default branch, and direct pushes to it (every path is protected unless
# guard.conf narrows protected_paths).
# Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -eu

default_branch="main"
protected_paths='.'
conf="$(git rev-parse --show-toplevel)/.githooks/guard.conf"
# shellcheck disable=SC1090
[ -f "$conf" ] && . "$conf"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/$default_branch" ] || continue

  case "$local_sha" in
    *[!0]*) ;;
    *)
      echo "BLOCKED: deleting $default_branch is not allowed." >&2
      exit 1
      ;;
  esac

  case "$remote_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "BLOCKED: $default_branch can only move forward; force-pushes are not allowed." >&2
    echo "Fetch and merge origin/$default_branch, then push again." >&2
    exit 1
  fi

  changed="$(git diff --name-only "$remote_sha" "$local_sha" | grep -E "$protected_paths" || true)"
  if [ -n "$changed" ]; then
    echo "BLOCKED: these files change only through a pull request, not a direct push to $default_branch:" >&2
    echo "$changed" | sed 's/^/  /' >&2
    echo "Push a branch and open a pull request instead." >&2
    exit 1
  fi
done
